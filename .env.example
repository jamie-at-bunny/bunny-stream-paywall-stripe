# Every variable the Edge Script reads. Set each one with:
#   bunny scripts env set NAME value [--secret]

# The public URL of the site (no trailing slash)
SITE_URL=https://video-shop.b-cdn.net
# 32+ random characters, e.g. `openssl rand -hex 32` (secret)
COOKIE_SECRET=

# Stripe: a restricted key that can read and write Checkout Sessions (secret)
STRIPE_SECRET_KEY=rk_test_...
STRIPE_PRICE_ID=price_...
# Signing secret of the checkout.session.completed webhook endpoint (secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# Bunny Stream. The token key is on Stream > library > Security (secret)
STREAM_LIBRARY_ID=123456
STREAM_VIDEO_ID=
STREAM_TOKEN_KEY=

# Resend, or swap sendLink() for any provider with an HTTP API (key is secret)
RESEND_API_KEY=re_...
EMAIL_FROM="Video Shop <hello@example.com>"
